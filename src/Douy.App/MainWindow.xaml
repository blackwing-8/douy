<Window x:Class="Douy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Douy.App"
        Title="兜鱼"
        Height="780"
        Width="1180"
        MinHeight="680"
        MinWidth="980"
        Background="#12141A"
        FontFamily="Microsoft YaHei UI"
        FontSize="14"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InvBoolVis"/>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2BB673"/>
            <Setter Property="Foreground" Value="#062117"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#39C984"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#1C1F27"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#2C3340" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1C1F27"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="BorderBrush" Value="#2C3340"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="兜鱼" FontSize="32" FontWeight="Bold" Foreground="#F4F7FB"/>
                <TextBlock Text="douy" Foreground="#2BB673" Margin="0,2,0,16"/>
                <TextBlock Text="局域网地址" Foreground="#9AA3B2"/>
                <TextBlock Text="点击地址即可复制。手机和电脑要在同一台路由器下，地址不同是正常的。"
                           Foreground="#9AA3B2" TextWrapping="Wrap" Margin="0,4,0,8" FontSize="12"/>
                <ItemsControl ItemsSource="{Binding Addresses}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Tag="{Binding}"
                                    Click="CopyAddress_Click"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    Foreground="#D7EDE6"
                                    BorderThickness="0"
                                    Padding="0,4"
                                    Cursor="Hand"
                                    FontSize="18"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="没有检测到局域网地址。请先用网线或 Wi-Fi 连上路由器。"
                           Foreground="#E0B15A"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Visibility="{Binding HasLanAddress, Converter={StaticResource InvBoolVis}}"/>

                <TextBlock Text="端口" Foreground="#9AA3B2" Margin="0,8,0,6"/>
                <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanEditPort}"
                         Margin="0,0,0,14"/>
                <Button Content="{Binding StartButtonText}"
                        Style="{StaticResource PrimaryButton}"
                        Click="Start_Click"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"/>
                <TextBlock Text="若手机一直连不上，在 Windows 防火墙里允许 douy 访问专用网络。手机上的兜鱼要留在前台。"
                           Foreground="#9AA3B2" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"/>

                <Border Background="#1C1F27" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <local:Row Title="状态" Value="{Binding Status}"/>
                        <local:Row Title="手机" Value="{Binding Phone}"/>
                        <local:Row Title="画面" Value="{Binding Source}"/>
                        <local:Row Title="帧率" Value="{Binding FpsText}"/>
                        <local:Row Title="尺寸" Value="{Binding ResolutionText}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="选择视频后，手机改播这个文件。不选就发送测试画面。也可以把视频拖进窗口。"
                           Foreground="#9AA3B2" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding VideoFileName}" Foreground="#F4F7FB" TextTrimming="CharacterEllipsis" ToolTip="{Binding VideoPath}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="选择视频" Style="{StaticResource GhostButton}" Click="ChooseVideo_Click"/>
                    <Button Grid.Column="2" Content="测试画面" Style="{StaticResource GhostButton}" Click="ClearVideo_Click" IsEnabled="{Binding HasVideo}"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="预览" Foreground="#9AA3B2" Margin="4,0,0,8"/>
            <Border Grid.Row="1" Background="#0C0E13" CornerRadius="16" ClipToBounds="True">
                <Image Source="{Binding Preview}" Stretch="Uniform"/>
            </Border>
        </Grid>
    </Grid>
</Window>
