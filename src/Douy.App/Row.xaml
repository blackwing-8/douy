<UserControl x:Class="Douy.App.Row"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="Transparent">
    <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Title, ElementName=Root}" Foreground="#9AA3B2" VerticalAlignment="Top"/>
        <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=Root}" Foreground="#F4F7FB" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
